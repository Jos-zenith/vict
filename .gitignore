# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Data and outputs (re-downloadable / regenerated)
# Leading slash = repo root only (plain data/ also matched src/vgate/data/).
# /dir/* rather than /dir/ so the .gitkeep re-includes actually apply.
/data/*
/results/*
!/data/.gitkeep
!/results/.gitkeep

# Papers (copyrighted; keep locally only)
docs/papers/*.pdf

# C / firmware build output
c/build/
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
